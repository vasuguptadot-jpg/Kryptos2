{
  "name": "kryptos-broker",
  "version": "1.0.0",
  "private": true,
  "description": "Kryptos Secret Broker — central, server-side-only secret broker / API gateway for Vercel.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed": "tsx scripts/seed.ts",
    "db:init": "node scripts/db-init.mjs",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "next": "15.5.6",
    "pg": "8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/pg": "8.11.10",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
