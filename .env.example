# ============================================================================
# KRYPTOS BROKER — Environment variables (copy to .env for LOCAL dev only)
# In production these are set in the Vercel dashboard. NEVER commit .env.
# ============================================================================

# --- Provider secrets (server-side only, NEVER NEXT_PUBLIC_*) --------------
GEMINI_API_KEY=
GROQ_API_KEY=
# Reserved for future push delivery. Never returned to clients.
VAPID_PRIVATE_KEY=
# Optional — only if you use Supabase as the Postgres metadata DB.
SUPABASE_SERVICE_ROLE_KEY=

# --- Metadata database (applications, permissions, audit, rate limits) -----
# Vercel Postgres / Neon / Supabase connection string.
DATABASE_URL=
# Only for local development / automated tests WITHOUT a database.
# Allowed values: "postgres" (default) | "memory".
# "memory" is REFUSED when NODE_ENV=production.
STORE_BACKEND=memory

# --- Admin dashboard bootstrap ----------------------------------------------
ADMIN_USERNAME=
# Use a long random string. Rotate periodically.
ADMIN_PASSWORD=
# 32+ byte random hex used to sign admin session cookies (openssl rand -hex 32).
ADMIN_SESSION_SECRET=

# --- Optional hardening ------------------------------------------------------
# Optional pepper appended into app credential hashes (sha256(pepper + key)).
CREDENTIAL_PEPPER=
# JSON arrays that restrict which models clients may request.
GEMINI_MODEL_ALLOWLIST=["gemini-2.0-flash","gemini-1.5-flash","gemini-1.5-flash-8b"]
GROQ_MODEL_ALLOWLIST=["llama-3.3-70b-versatile","llama-3.1-8b-instant","mixtral-8x7b-32768"]
# Per-credential requests per minute when nothing else is specified.
APP_DEFAULT_RATE_LIMIT=60
# Provider call timeout in milliseconds.
PROVIDER_TIMEOUT_MS=30000
